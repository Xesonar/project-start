# Runtime: development | production. Production rejects unsafe auth defaults.
APP_ENV=development

# PostgreSQL
POSTGRES_USER=project_start
POSTGRES_PASSWORD=project_start
POSTGRES_DB=project_start
DATABASE_URL=postgresql+psycopg://project_start:project_start@db:5432/project_start

# MAX bot / mini app
MAX_BOT_TOKEN=
MAX_INIT_DATA_MAX_AGE_SECONDS=3600
# Verified against the X-Max-Bot-Api-Secret header on incoming bot webhook
# calls — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MAX_BOT_WEBHOOK_SECRET=

# Auth
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRE_DAYS=7
ADMIN_PASSWORD=change-me
AUTH_RATE_LIMIT_PER_MINUTE=20
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
WEBHOOK_DEDUP_TTL_SECONDS=600
NOTIFICATION_RETRY_SECONDS=30

# AI recommendations (DeepSeek API, OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# CORS (comma-separated origins allowed to call the backend)
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000
